{
  "name": "on-point-crm",
  "version": "1.0.0",
  "description": "On Point Pro Doors CRM",
  "private": true,
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "start": "node server.js",
    "bump-cache": "node -e \"const fs=require('fs');const v='v'+new Date().toISOString().slice(0,10).replace(/-/g,'')+'-'+Date.now().toString(36).slice(-4);const f=fs.readFileSync('sw.js','utf8').replace(/CACHE_VERSION = '[^']+'/,\\`CACHE_VERSION = '\\${v}'\\`);fs.writeFileSync('sw.js',f);console.log('Cache version:',v);\"",
    "test": "node --check server.js && node tests/static-whitelist.test.js && node tests/dispatch-date.test.js && node tests/estimate-followup.test.js && node tests/reopen-lost.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "express": "^4.22.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "playwright": "^1.59.1",
    "sharp": "^0.33.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
